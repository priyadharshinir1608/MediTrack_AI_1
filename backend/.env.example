PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@cluster0.xxxxx.mongodb.net/medscan_ai?retryWrites=true&w=majority&appName=Cluster0
AI_SERVICE_URL=http://localhost:8000

# ====================================================================
# 1. GMAIL SMTP ALERT CONFIGURATION (Nodemailer)
# ====================================================================
# How to get Gmail App Password:
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Turn ON 2-Step Verification
# 3. Search for "App Passwords" or navigate to https://myaccount.google.com/apppasswords
# 4. Create an App Name (e.g. "MedScan AI") and generate the 16-character password
# 5. Paste sender email and the 16-letter password below:
EMAIL_USER=your_sender_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ====================================================================
# 2. WHATSAPP ALERT CONFIGURATION (Choose ONE of Option A, B, or C)
# ====================================================================

# OPTION A: Meta / Facebook WhatsApp Cloud API (Free tier: 1000 chats/mo)
# From Meta Developer Portal -> WhatsApp -> API Setup:
WHATSAPP_API_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# OPTION B: Twilio WhatsApp API
# From Twilio Console Dashboard:
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=+14155238886

# OPTION C: CallMeBot WhatsApp Bot API (Instant free testing bot)
# Get key by sending WhatsApp message "I allow callmebot to send me messages" to +34 91 106 16 37
# CALLMEBOT_API_KEY=your_callmebot_api_key
